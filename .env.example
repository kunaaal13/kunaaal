# Copy to `.env` and fill in. Every consumer degrades gracefully when a key is
# missing, so `bun dev` works on a fresh clone with none of these set.

# Canonical site URL. Used for sitemap, canonicals, OG tags and JSON-LD.
PUBLIC_SITE_URL="https://kunaaal.com"

# --- Runtime (serverless) ---------------------------------------------------
# Spotify now-playing. Without these, /api/spotify returns { isPlaying: false }
# and the widget shows "Offline" — the page is otherwise unaffected.
#
# One-time setup. Create an app at developer.spotify.com and register this
# redirect URI (it matches `astro dev`; the port only has to agree with the
# authorize call below):
#
#     http://127.0.0.1:4321/callback
#
# Use 127.0.0.1, not localhost — Spotify stopped accepting `localhost` in
# redirect URIs in 2025, and plain http is only allowed on a loopback address.
#
# 1. Open, substituting your client ID:
#      https://accounts.spotify.com/authorize
#        ?client_id=<ID>
#        &response_type=code
#        &redirect_uri=http://127.0.0.1:4321/callback
#        &scope=user-read-currently-playing
#
# 2. Approve. You will land on a 404 — expected, there is no /callback route.
#    Copy the `code=` value out of the address bar. It expires in ~60s.
#
# 3. Exchange it for a refresh token:
#      curl -X POST https://accounts.spotify.com/api/token \
#        -H "Authorization: Basic $(printf '%s:%s' "$ID" "$SECRET" | base64)" \
#        -d grant_type=authorization_code \
#        -d code=<CODE> \
#        -d redirect_uri=http://127.0.0.1:4321/callback
#
# The refresh token does not expire unless access is revoked. After this the
# site never redirects — /api/spotify exchanges it server-to-server.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REFRESH_TOKEN=""

# No contact-form variables. /contact links to a booking page and real
# inboxes instead of posting to an endpoint — nothing to configure, nothing
# to keep alive, and no messages passing through this site.
