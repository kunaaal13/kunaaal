---
import { render } from 'astro:content'
import BaseLayout from '@/app/layouts/BaseLayout.astro'
import Panel from '@/shared/ui/Panel.astro'
import PanelContent from '@/shared/ui/PanelContent.astro'
import Prose from '@/shared/ui/Prose.astro'
import Tag from '@/shared/ui/Tag.astro'
import { formatDate, toISODate } from '@/shared/lib/date'
import { postGraph } from '@/app/lib/json-ld'
import type { Post } from '@/entities/post'

export interface Props {
  post: Post
}

const { post } = Astro.props
// `image` is the in-page hero, deliberately not the OG card — the card is
// generated per post at /og/blog/<id>.png.
const { title, description, tags, publishedAt, updatedAt } = post.data
const { Content, headings } = await render(post)
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href

// Only h2/h3 make a useful outline; deeper levels turn it into noise.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3)
---

<BaseLayout
  title={title}
  description={description}
  image={`/og/blog/${post.id}.png`}
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  jsonLd={postGraph(post, canonical)}
>
  <div class="mx-auto md:max-w-3xl">
    <Panel>
      <PanelContent class="space-y-4">
        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground"
        >
          <svg
            class="size-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M19 12H5M11 18l-6-6 6-6"></path>
          </svg>
          All posts
        </a>

        <h1 class="text-3xl font-medium tracking-tight text-balance">{title}</h1>
        <p class="text-[15px] text-muted-foreground">{description}</p>

        <dl class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
          <dt class="sr-only">Published</dt>
          <dd>
            <time datetime={toISODate(publishedAt)}>
              {formatDate(publishedAt)}
            </time>
          </dd>
          {
            updatedAt && (
              <>
                <dd class="h-4 w-px bg-border" aria-hidden="true" />
                <dt class="sr-only">Updated</dt>
                <dd>Updated {formatDate(updatedAt)}</dd>
              </>
            )
          }
        </dl>

        {
          tags.length > 0 && (
            <ul class="flex flex-wrap gap-1.5">
              {tags.map((tag) => (
                <li class="flex">
                  <Tag>{tag}</Tag>
                </li>
              ))}
            </ul>
          )
        }
      </PanelContent>
    </Panel>

    {
      toc.length > 2 && (
        <Panel seamlessTop>
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-mono text-xs tracking-wide text-muted-foreground uppercase">
              Contents
              <span class="ml-1 inline-block transition-transform group-open:rotate-90">
                ›
              </span>
            </summary>
            <ul class="mt-3 space-y-1.5 text-sm">
              {toc.map((heading) => (
                <li class={heading.depth === 3 ? 'pl-4' : ''}>
                  <a
                    href={`#${heading.slug}`}
                    class="text-muted-foreground transition-colors hover:text-foreground"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </Panel>
      )
    }

    <Panel seamlessTop>
      <PanelContent>
        <Prose>
          <Content />
        </Prose>
      </PanelContent>
    </Panel>
  </div>
</BaseLayout>
