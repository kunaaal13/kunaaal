---
import BaseLayout from '@/app/layouts/BaseLayout.astro'
import Separator from '@/shared/ui/Separator.astro'
import { homeGraph } from '@/app/lib/json-ld'

import ProfileHeader from './ProfileHeader.astro'
import Overview from './Overview.astro'
import NowPlayingBand from './NowPlayingBand.astro'
import ConnectGrid from './ConnectGrid.astro'
import About from './About.astro'
import StackSection from './StackSection.astro'
import ProjectsSection from './ProjectsSection.astro'
import ExperienceSection from './ExperienceSection.astro'
import OpenSourceSection from './OpenSourceSection.astro'
import BlogSection from './BlogSection.astro'
import CTA from './CTA.astro'
---

<BaseLayout jsonLd={homeGraph()}>
  <div class="mx-auto md:max-w-3xl">
    <ProfileHeader />

    {/*
      The identity block is its own unit: header, then a stripe band, then the
      facts that describe it. Running the header straight into Overview was a
      big part of why the top of the page read as congested — there was no
      pause between "who" and "details".
    */}
    <Separator />
    <Overview />
    <NowPlayingBand />
    <ConnectGrid />

    <Separator />
    <About />

    <Separator />
    <StackSection />

    <Separator />
    <ProjectsSection />

    <Separator />
    <ExperienceSection />

    <Separator />
    <OpenSourceSection />

    <Separator />
    <BlogSection />

    <Separator />
    <CTA />
  </div>
</BaseLayout>
