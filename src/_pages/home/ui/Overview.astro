---
import Panel from '@/shared/ui/Panel.astro'
import PanelContent from '@/shared/ui/PanelContent.astro'
import LocalTime from '@/shared/ui/LocalTime.svelte'
import { PROFILE, getEmail } from '@/entities/profile'

const email = getEmail()

/**
 * The boxed icon well. Bordering each glyph is what turns a list of rows into
 * a spec sheet — every value reads as a labelled field rather than loose text
 * with a symbol next to it.
 */
const ICON_BOX =
  'flex size-6.5 shrink-0 items-center justify-center rounded-lg border border-border bg-muted/45 text-muted-foreground [&_svg]:size-3.5 [&_svg]:stroke-linecap-round [&_svg]:stroke-linejoin-round'
---

<Panel seamlessBottom>
  <h2 class="sr-only">Overview</h2>

  <PanelContent class="grid gap-x-4 gap-y-2.5 font-mono text-sm sm:grid-cols-2">
    {/*
      Order is deliberate. Row-wise in two columns, so it reads:
        roles          →  what I do
        building · location
        local time · email
      Both roles sit together on the first row rather than being separated by
      unrelated facts.
    */}
    {
      PROFILE.roles.map((role, index) => (
        <div class="flex items-center gap-2">
          <span class={ICON_BOX}>
            {index === 0 ? (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <path d="m16 18 6-6-6-6M8 6l-6 6 6 6" />
              </svg>
            ) : (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-5h6v5" />
              </svg>
            )}
          </span>
          <span class="flex min-w-0 items-center gap-2">
            {/* No `@` prefix: that reads as a handle, and these are company
                names. The link carries the emphasis instead. */}
            <span class="truncate">
              {role.title}{' '}
              <a class="link font-medium" href={role.url} target="_blank" rel="noopener">
                {role.company}
              </a>
            </span>

            {index === 0 && PROFILE.availableForWork && (
              <span
                class="relative flex size-2 shrink-0 items-center justify-center"
                title="Available for work"
              >
                <span class="sr-only">Available for work</span>
                <span
                  class="absolute inline-flex size-2 animate-ping rounded-full bg-success opacity-60"
                  aria-hidden="true"
                />
                <span
                  class="relative inline-flex size-1.5 rounded-full bg-success"
                  aria-hidden="true"
                />
              </span>
            )}
          </span>
        </div>
      ))
    }

    {/* Currently building */}
    {
      PROFILE.building && (
        <div class="flex items-center gap-2">
          <span class={ICON_BOX}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2Z" />
            </svg>
          </span>
          <span class="min-w-0 truncate">
            Building{' '}
            <a class="link font-medium" href={PROFILE.building.url} target="_blank" rel="noopener">
              {PROFILE.building.name}
            </a>
          </span>
        </div>
      )
    }

    {/* Location */}
    <div class="flex items-center gap-2">
      <span class={ICON_BOX}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
      </span>
      <a
        class="link min-w-0 truncate"
        href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(PROFILE.location)}`}
        target="_blank"
        rel="noopener"
      >
        {PROFILE.location}
      </a>
    </div>

    {/* Local time */}
    <div class="flex items-center gap-2">
      <span class={ICON_BOX}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 7v5l3 2"></path>
        </svg>
      </span>
      <span class="flex min-w-0 items-center gap-1.5">
        <LocalTime client:visible timeZone={PROFILE.timeZone} />
      </span>
    </div>

    {/* Email */}
    <div class="flex items-center gap-2">
      <span class={ICON_BOX}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
          <rect x="2" y="4" width="20" height="16" rx="2"></rect>
          <path d="m2 7 10 6 10-6"></path>
        </svg>
      </span>
      <a class="link min-w-0 truncate" href={`mailto:${email}`}>{email}</a>
    </div>

  </PanelContent>

  {/* Dashed rule down the column gap, desktop only. */}
  <div
    class="dashed-rule-y pointer-events-none absolute top-px bottom-0 left-1/2 -z-1 w-px -translate-x-2.25 max-sm:hidden"
    aria-hidden="true"
  >
  </div>
</Panel>
