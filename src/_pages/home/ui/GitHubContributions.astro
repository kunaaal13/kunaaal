---
import Panel from '@/shared/ui/Panel.astro'
import PanelContent from '@/shared/ui/PanelContent.astro'
import { getContributions } from '@/shared/api/github'
import { SOCIAL } from '@/shared/config/social'
import { formatDate } from '@/shared/lib/date'

const contributions = await getContributions(SOCIAL.github.handle)

const CELL = 10
const GAP = 3
const RADIUS = 2

// Level → opacity against currentColor, so the graph tracks the theme instead
// of carrying its own light and dark palettes.
const OPACITY = [0.08, 0.25, 0.45, 0.68, 0.9]
---

{
  contributions && (
    <Panel seamlessTop>
      <h2 class="sr-only">GitHub contributions</h2>

      <PanelContent class="space-y-3">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <p class="font-mono text-sm text-muted-foreground">
            <span class="font-medium text-foreground">
              {contributions.total.toLocaleString()}
            </span>{' '}
            contributions in the last year
          </p>
          <a
            href={SOCIAL.github.href}
            target="_blank"
            rel="noopener"
            class="font-mono text-xs text-muted-foreground transition-colors hover:text-foreground"
          >
            @{SOCIAL.github.handle}
          </a>
        </div>

        {/* Scrolls on narrow screens rather than squashing the cells. */}
        <div class="-mx-1 overflow-x-auto px-1 pb-1">
          <svg
            width={contributions.weeks.length * (CELL + GAP)}
            height={7 * (CELL + GAP)}
            class="text-foreground"
            role="img"
            aria-label={`${contributions.total} GitHub contributions between ${formatDate(contributions.from)} and ${formatDate(contributions.to)}`}
          >
            {contributions.weeks.map((week, x) =>
              week.map((day) => {
                // Place by weekday so partial first and last weeks align.
                const y = new Date(day.date).getUTCDay()
                return (
                  <rect
                    x={x * (CELL + GAP)}
                    y={y * (CELL + GAP)}
                    width={CELL}
                    height={CELL}
                    rx={RADIUS}
                    fill="currentColor"
                    opacity={OPACITY[day.level]}
                  >
                    <title>
                      {day.count === 0
                        ? `No contributions on ${formatDate(day.date)}`
                        : `${day.count} contribution${day.count === 1 ? '' : 's'} on ${formatDate(day.date)}`}
                    </title>
                  </rect>
                )
              })
            )}
          </svg>
        </div>

        <div class="flex items-center gap-1.5 font-mono text-xs text-muted-foreground">
          <span>Less</span>
          {OPACITY.map((opacity) => (
            <span
              class="size-2.5 rounded-sm bg-current"
              style={`opacity: ${opacity}`}
              aria-hidden="true"
            />
          ))}
          <span>More</span>
        </div>
      </PanelContent>
    </Panel>
  )
}
