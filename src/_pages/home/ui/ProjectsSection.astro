---
import Panel from '@/shared/ui/Panel.astro'
import PanelHeader from '@/shared/ui/PanelHeader.astro'
import PanelTitle from '@/shared/ui/PanelTitle.astro'
import { ProjectCard, getFeaturedProjects, getProjects } from '@/entities/project'

const featured = await getFeaturedProjects()
const total = (await getProjects()).length
---

<Panel id="projects">
  <PanelHeader>
    <PanelTitle id="projects" sup={total}>Projects</PanelTitle>
  </PanelHeader>

  <div class="relative p-4">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>

  {
    total > featured.length && (
      <div class="screen-line-top flex justify-center py-4">
        <a
          href="/projects"
          class="inline-flex h-8 items-center gap-2 rounded-md bg-muted px-3 text-sm font-medium transition-colors hover:bg-accent"
        >
          All projects
          <svg
            class="size-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    )
  }
</Panel>
