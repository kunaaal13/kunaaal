---
import BaseLayout from '@/app/layouts/BaseLayout.astro'
import Panel from '@/shared/ui/Panel.astro'
import PanelHeader from '@/shared/ui/PanelHeader.astro'
import PanelTitle from '@/shared/ui/PanelTitle.astro'
import PanelContent from '@/shared/ui/PanelContent.astro'
import Icon from '@/shared/ui/Icon.astro'
import LocalTime from '@/shared/ui/LocalTime.svelte'
import { SOCIAL } from '@/shared/config/social'
import { PROFILE, getEmail } from '@/entities/profile'

/*
 * No form.
 *
 * A contact form is a worse version of the channels someone is already signed
 * in to: it needs an endpoint, a mail provider, spam handling, and it gives no
 * confirmation the message went anywhere. Links to real inboxes and a booking
 * page do the same job with nothing to maintain.
 *
 * Each channel says what it is good for, so the choice is obvious rather than
 * a wall of equivalent-looking icons.
 */
const email = getEmail()

const channels = [
  {
    name: 'Email',
    handle: email,
    href: `mailto:${email}`,
    best: 'Anything with detail — proposals, long questions, attachments.',
    glyph: 'mail' as const,
  },
  {
    name: 'X',
    handle: SOCIAL.x.handle,
    href: SOCIAL.x.href,
    best: 'Quick things. DMs are open.',
    icon: SOCIAL.x.icon,
  },
  {
    name: 'LinkedIn',
    handle: SOCIAL.linkedin.handle,
    href: SOCIAL.linkedin.href,
    best: 'Roles and anything that needs a paper trail.',
    icon: SOCIAL.linkedin.icon,
    brandColor: true,
  },
  {
    name: 'GitHub',
    handle: SOCIAL.github.handle,
    href: SOCIAL.github.href,
    best: 'Issues, pull requests, and the code itself.',
    icon: SOCIAL.github.icon,
  },
]
---

<BaseLayout
  title="Contact"
  description="Book a call, or reach me anywhere you already are."
>
  <div class="mx-auto md:max-w-3xl">
    <Panel>
      <PanelHeader>
        <PanelTitle id="contact" as="h1">Contact</PanelTitle>
      </PanelHeader>

      <PanelContent class="space-y-4">
        {
          PROFILE.availableForWork && (
            <div class="flex items-center gap-2">
              <span
                class="relative flex size-2 items-center justify-center"
                aria-hidden="true"
              >
                <span class="absolute inline-flex size-2 animate-ping rounded-full bg-success opacity-60" />
                <span class="relative inline-flex size-1.5 rounded-full bg-success" />
              </span>
              <span class="font-mono text-xs tracking-wide text-muted-foreground uppercase">
                Open to work
              </span>
            </div>
          )
        }

        <p class="max-w-xl text-xl leading-snug font-medium text-balance sm:text-2xl">
          Shoot me a message anywhere — whichever you already have open.
        </p>
        <p class="max-w-xl text-[15px]/[1.75] text-muted-foreground">
          Freelance projects, full-time roles, or a problem you want a second
          opinion on. If it's easier to just talk, grab a slot and we'll work
          through it properly.
        </p>
      </PanelContent>
    </Panel>

    {/* The call, given its own panel — it is the action worth taking. */}
    <Panel seamlessTop>
      <a
        href={PROFILE.scheduling}
        target="_blank"
        rel="noopener"
        class="group flex items-center gap-5 p-5 transition-colors hover:bg-accent-muted sm:p-6"
      >
        <div
          class="relative flex size-12 shrink-0 items-center justify-center rounded-xl bg-foreground text-background"
        >
          <svg
            class="size-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="16" rx="2"></rect>
            <path d="M8 3v4M16 3v4M3 11h18"></path>
          </svg>
        </div>

        <div class="min-w-0 flex-1">
          <h2 class="font-medium">Book a 30-minute call</h2>
          <p class="mt-0.5 text-sm text-muted-foreground">
            Pick a time that suits you — no back-and-forth to find one.
          </p>
        </div>

        <svg
          class="size-5 shrink-0 text-muted-foreground transition-transform group-hover:translate-x-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </Panel>

    <Panel seamlessTop id="elsewhere">
      <PanelHeader>
        <PanelTitle id="elsewhere">Elsewhere</PanelTitle>
      </PanelHeader>

      <ul class="grid grid-cols-1 sm:grid-cols-2">
        {
          channels.map((channel) => (
            <li
              class:list={[
                'screen-line-bottom relative',
                'last:screen-line-bottom-none',
                'sm:nth-last-[-n+2]:screen-line-bottom-none',
                'sm:nth-[2n+1]:border-r sm:nth-[2n+1]:border-line',
              ]}
            >
              <a
                href={channel.href}
                target={channel.href.startsWith('http') ? '_blank' : undefined}
                rel="noopener"
                class="group flex h-full flex-col gap-1 p-4 transition-colors hover:bg-accent-muted"
              >
                <div class="flex items-center gap-2.5">
                  <span class="flex size-5 shrink-0 items-center justify-center text-muted-foreground transition-colors group-hover:text-foreground">
                    {channel.icon ? (
                      <Icon
                        name={channel.icon}
                        class="size-4"
                        brand={channel.brandColor}
                      />
                    ) : (
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="size-4"
                        aria-hidden="true"
                      >
                        <rect x="2" y="4" width="20" height="16" rx="2" />
                        <path d="m2 7 10 6 10-6" />
                      </svg>
                    )}
                  </span>

                  <span class="font-medium">{channel.name}</span>

                  <span class="ml-auto truncate font-mono text-xs text-muted-foreground">
                    {channel.handle}
                  </span>
                </div>

                <p class="pl-7.5 text-sm text-muted-foreground">{channel.best}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </Panel>

    {/* Sets expectations without promising a response time I cannot keep. */}
    <Panel seamlessTop>
      <PanelContent
        class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs text-muted-foreground"
      >
        <span>It's</span>
        <LocalTime client:visible timeZone={PROFILE.timeZone} />
        <span>where I am — {PROFILE.location}.</span>
      </PanelContent>
    </Panel>
  </div>
</BaseLayout>
