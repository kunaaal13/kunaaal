---
export interface Props {
  data: unknown
}

const { data } = Astro.props
---

{/*
  set:html rather than interpolation — Astro escapes interpolated text, which
  would corrupt the JSON. The payload is built from our own config, never from
  user input.
*/}
<script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />
