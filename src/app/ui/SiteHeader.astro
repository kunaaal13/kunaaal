---
import { ThemeToggle } from '@/features/theme-toggle'
import { CommandMenu } from '@/features/command-menu'
import { buildSearchIndex } from '@/app/lib/build-search-index'
import SiteMark from './SiteMark.astro'
import Icon from '@/shared/ui/Icon.astro'
import { NAV, SITE } from '@/shared/config/site'
import { SOCIAL } from '@/shared/config/social'

const path = Astro.url.pathname
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href)

// Built at build time, handed to the island as a prop — no runtime fetch.
const searchIndex = await buildSearchIndex()
---

<header
  class="sticky top-0 z-50 max-w-screen overflow-x-clip bg-background px-2"
>
  <div
    class="screen-line-top screen-line-bottom mx-auto flex h-(--header-height)
           items-center gap-2 border-x border-line px-3 sm:gap-4 md:max-w-3xl"
  >
    <a href="/" aria-label={`${SITE.name} — home`}>
      <SiteMark class="h-7 w-auto" />
    </a>

    <div class="flex-1"></div>

    <nav aria-label="Main" class="max-sm:hidden">
      <ul class="flex items-center gap-4 text-sm">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'transition-colors hover:text-foreground',
                  isActive(item.href)
                    ? 'text-foreground'
                    : 'text-muted-foreground',
                ]}
              >
                {item.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/* Separator-delimited utility cluster, matching the nav's rhythm. */}
    <div class="flex items-center">
      <div class="mx-2 h-5 w-px bg-line max-sm:hidden"></div>

      {/*
        client:idle — search is never the first thing anyone does, so it can
        wait for the main thread to go quiet. ⌘K still binds well before a
        visitor has finished reading the page.
      */}
      <CommandMenu client:idle items={searchIndex} />

      <div class="mx-2 h-5 w-px bg-line max-sm:hidden"></div>

      <a
        href={SOCIAL.github.href}
        target="_blank"
        rel="noopener"
        class="flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground max-sm:hidden"
        aria-label="GitHub profile"
      >
        <Icon name="siGithub" class="size-4" />
      </a>

      <div class="mx-2 h-5 w-px bg-line"></div>

      <ThemeToggle />
    </div>
  </div>

  {/*
    Mobile search: plain HTML that dispatches an event the island listens for,
    so there is no second island for what is really one feature.
  */}
  <button
    type="button"
    data-command-menu-open
    class="fixed inset-x-0 bottom-6 z-40 mx-auto flex w-fit items-center gap-2 rounded-full
           border border-border bg-background/95 px-5 py-2 text-sm shadow-lg backdrop-blur-md
           transition-transform active:scale-95 sm:hidden"
  >
    <svg
      class="size-4"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m21 21-4.3-4.3"></path>
    </svg>
    Search
  </button>
</header>

<script>
  // Delegated so it survives router DOM swaps, same as the theme toggle.
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null
    if (!target?.closest('[data-command-menu-open]')) return
    window.dispatchEvent(new CustomEvent('command-menu:open'))
  })
</script>
