---
import { QUOTES } from '@/shared/config/quotes'

// Cache deferred island response for ten minutes in browser and Cloudflare CDN.
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=600, s-maxage=600, stale-while-revalidate=60',
)

/*
 * Rendered as a server island (`server:defer` where this is used), so this
 * runs per cache window rather than on every request. The rest of the page
 * stays static HTML on the CDN; only this fragment is dynamic.
 */
const quote = QUOTES[Math.floor(Math.random() * QUOTES.length)]
---

<figure class="flex flex-col items-center px-6 py-14 text-center">
  <svg
    class="mb-6 size-9 fill-current text-muted-foreground/25"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path
      d="M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"
    ></path>
    <path
      d="M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"
    ></path>
  </svg>

  {
    quote.sanskrit && (
      // Devanagari falls back to a system Indic face — Geist has no coverage,
      // and bundling one for a single line is not worth ~100 kB.
      <p
        class="mb-5 max-w-2xl text-base/relaxed text-muted-foreground/80 sm:text-lg/relaxed"
        lang="sa"
      >
        {quote.sanskrit}
      </p>
    )
  }

  <blockquote
    class="mb-6 max-w-2xl text-xl font-medium text-balance italic sm:text-2xl"
  >
    {quote.text}
  </blockquote>

  <figcaption class="flex items-center gap-3">
    <span class="h-px w-8 bg-border" aria-hidden="true"></span>
    <cite
      class="font-mono text-xs tracking-wider text-muted-foreground uppercase not-italic"
    >
      {quote.attribution}
    </cite>
    <span class="h-px w-8 bg-border" aria-hidden="true"></span>
  </figcaption>
</figure>
