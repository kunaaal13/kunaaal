---
import { cn } from '@/shared/lib/cn'
import Icon from '@/shared/ui/Icon.astro'
import { STATUS_META, type Project } from '../model/project'

export interface Props {
  project: Project
  class?: string
  /** Give the cover a view-transition name so it morphs into the detail page. */
  morph?: boolean
}

const { project, class: className, morph = true } = Astro.props
const { title, description, cover, status, tech, links } = project.data
const status_ = STATUS_META[status]
const href = `/projects/${project.id}`
---

<article
  class={cn(
    'group/card relative flex flex-col gap-1 overflow-hidden rounded-xl border border-border',
    'bg-background/50 p-2 shadow-sm transition-colors',
    'hover:bg-accent-muted',
    className
  )}
>
  <a href={href} class="flex flex-1 flex-col gap-1">
    {/* Stretched link: the whole card is clickable, but only the <a> is
        focusable, so keyboard users get one stop rather than three. */}
    <span class="absolute inset-0 z-10" aria-hidden="true"></span>

    {
      cover ? (
        <img
          src={cover}
          alt=""
          width="1200"
          height="630"
          loading="lazy"
          decoding="async"
          class="h-44 w-full rounded-lg object-cover object-top grayscale transition-[filter] duration-300 group-hover/card:grayscale-0"
          style={morph ? `view-transition-name: project-${project.id}` : undefined}
        />
      ) : (
        <div
          class="flex h-44 w-full items-center justify-center rounded-lg bg-surface diagonal-stripes"
          aria-hidden="true"
        >
          <span class="font-mono text-3xl text-muted-foreground/60">
            {title.slice(0, 2).toLowerCase()}
          </span>
        </div>
      )
    }

    <div class="mt-2.5 flex items-center justify-between gap-2 px-1">
      <h3
        class="text-lg leading-snug font-medium text-balance group-hover/card:underline underline-offset-4"
      >
        {title}
      </h3>

      <div class="flex shrink-0 items-center gap-1.5 select-none">
        <span class={cn('inline-flex size-2 rounded-full', status_.dot)}></span>
        <span class="text-xs font-medium text-muted-foreground">
          {status_.label}
        </span>
      </div>
    </div>

    <p class="line-clamp-2 min-h-10 px-1 text-sm text-muted-foreground">
      {description}
    </p>

    {
      tech.length > 0 && (
        <ul class="flex flex-wrap gap-1.5 px-1 pt-1">
          {tech.slice(0, 4).map((name) => (
            <li class="rounded-sm border bg-background px-1.5 py-0.5 text-xs text-muted-foreground select-none">
              {name}
            </li>
          ))}
        </ul>
      )
    }
  </a>

  {
    (links.live || links.github) && (
      <div class="relative z-20 mt-2 flex items-center border-t border-border pt-2 text-sm">
        {links.live && (
          <a
            href={links.live}
            target="_blank"
            rel="noopener"
            class={cn(
              'flex w-full items-center justify-center gap-2 text-muted-foreground transition-colors hover:text-foreground',
              links.github && 'border-r border-border'
            )}
          >
            Live
          </a>
        )}
        {links.github && (
          <a
            href={links.github}
            target="_blank"
            rel="noopener"
            class="flex w-full items-center justify-center gap-2 text-muted-foreground transition-colors hover:text-foreground"
          >
            GitHub
            <Icon name="siGithub" class="size-3.5" />
          </a>
        )}
      </div>
    )
  }
</article>
