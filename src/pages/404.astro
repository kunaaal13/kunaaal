---
import BaseLayout from '@/app/layouts/BaseLayout.astro'
import Panel from '@/shared/ui/Panel.astro'
import PanelContent from '@/shared/ui/PanelContent.astro'
---

<BaseLayout title="Not found" noindex>
  <div class="mx-auto md:max-w-3xl">
    <Panel>
      <PanelContent class="flex flex-col items-center gap-4 py-20 text-center">
        <p class="font-mono text-sm text-muted-foreground">404</p>
        <h1 class="text-3xl font-medium tracking-tight text-balance">
          This page doesn't exist
        </h1>
        <p class="max-w-sm text-sm text-balance text-muted-foreground">
          The link may be out of date, or the page may have moved.
        </p>
        <a
          href="/"
          class="mt-2 inline-flex h-8 items-center gap-2 rounded-md bg-foreground px-3 text-sm font-medium text-background transition-opacity hover:opacity-90"
        >
          Back home
        </a>
      </PanelContent>
    </Panel>
  </div>
</BaseLayout>
